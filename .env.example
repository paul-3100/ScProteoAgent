# Configuration template for a live agent run.
#
# Copy this file to `.env` next to main_agent.py and fill in your own values. Every value here
# is intentionally empty: no endpoint, model name or key of any provider is pre-filled.
#
# llm.py reads only `<project>/.env`; if that file is absent it reads this template with
# override disabled, and a missing required value then stops the run with a clear message
# instead of silently reusing another configuration on the machine.

# --- Model access (required for a live run) ------------------------------------
# OpenAI-compatible endpoint and model. The model name is recorded in the run metadata and is
# reported as a scientific parameter of the run, so use the exact name your provider exposes.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional separate model for the review layer of the frozen independent scorer.
# Left empty, it falls back to OPENAI_MODEL.
SCORE_MODEL=

# --- Optional Google-compatible helper APIs ------------------------------------
# Only needed by the Google-backed search/knowledge helpers.
# GOOGLE_BASE_URL=
# GOOGLE_API_KEY=
# GOOGLE_CX=
# SERPAPI_KEY=

# --- Local knowledge base and dataset roots ------------------------------------
# RAG_DATA=            (code default: ./kb_source/gene_protein)
# SCPROTEOMICS_DATA_ROOT=   dataset root used by the batch/evaluation scripts
# ENTREZ_EMAIL=        contact address for NCBI Entrez requests (code default: example@example.com)

# --- Opt-in network switches for knowledge tools -------------------------------
# Both default to "0" (offline). Set to 1 only if you want the tool to query a remote API.
# SC_ENRICH_ALLOW_ONLINE=
# SC_PPI_ALLOW_ONLINE=

# --- Run and report switches ---------------------------------------------------
# Values accepted by the code: legacy|hybrid for the assembly mode; 1/0 for the switches.
# SCPROTEO_REPORT_ASSEMBLY=
# SCPROTEO_REQUEST_EVIDENCE_INDEX=
# SCPROTEO_PERSIST_RAW_RESPONSE=

# --- Request envelope (optional) ------------------------------------------------
# The R27_ prefix is read first, R26_ is accepted as a fallback. Code defaults are shown in the
# comments; leave the assignment empty to keep them.
# R27_BUDGET_DIR=
# R27_MAX_ATTEMPTS=        (code default: 26)
# R27_MAX_INPUT_TOKENS=    (code default: 240000)
# R27_MAX_OUTPUT_TOKENS=   (code default: 40000)
# R27_PER_CALL_OUTPUT_CAP= (code default: 8000)
# R27_STOP_RESERVE=        (code default: 2000)
# R27_INPUT_MARGIN=        (code default: 1.0)
# R27_SHARED_ENVELOPE=     (code default: 0)
# R27_CALL_TIMEOUT_SEC=    (code default: 0 = no extra timeout)
