# Citation metadata for the software release candidate.
# The source repository exists and is recorded in repository-code; it is private at the time of
# writing. No release tag, commit hash or DOI exists yet, so identifiers and version are added only
# after the repository becomes public and a DOI is minted.
cff-version: 1.2.0
message: "If you use ScProteoAgent, please cite the manuscript listed below."
title: "ScProteoAgent enables natural-language-driven single-cell proteomics analysis and interpretation"
version: "1.0.0-rc.1"
license: "LicenseRef-scProteoAgent-Research-1.0"
